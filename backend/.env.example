# ─────────────────────────────────────────────────────────────
# Portfolio API — environment template
# Copy this file to `.env` and fill in real values for your
# environment. Never commit the real `.env` file.
# ─────────────────────────────────────────────────────────────

# The environment the app is running in: development | production
APP_ENV=development

# Set to false in production.
DEBUG=true

# REQUIRED — PostgreSQL connection string.
# Format: postgresql+psycopg://user:password@host:port/database
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/portfolio

# REQUIRED — JWT signing key. Must be unique per environment and stay secret.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# SMTP settings used for contact-form email forwarding.
# Leave MAIL_USERNAME/MAIL_PASSWORD empty to skip sending.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=your-email@gmail.com
MAIL_TO=your-email@gmail.com
MAIL_TLS=true

# Local folder where uploaded files are stored.
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=5
MAX_RESUME_SIZE_MB=5

# First-time admin account. Seeded only if no admin exists yet.
# The password here is only used once; change it later from the admin panel.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# How often a single visitor can submit the contact form.
CONTACT_RATE_LIMIT=1/minute

# local (default) | cloud (requires a CloudStorageService implementation)
STORAGE_DRIVER=local

# ─────────────────────────────────────────────────────────────
# Keep-alive scheduler (ping /health to keep Render warm)
# Set KEEP_ALIVE_ENABLED=false for local development.
# ─────────────────────────────────────────────────────────────
KEEP_ALIVE_ENABLED=false
KEEP_ALIVE_URL=https://fullstack-dynamic-portfolio-tai9.onrender.com/health
KEEP_ALIVE_INTERVAL=300
KEEP_ALIVE_TIMEOUT=10